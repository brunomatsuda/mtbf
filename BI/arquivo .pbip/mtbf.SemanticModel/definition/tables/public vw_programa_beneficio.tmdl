	partition 'public vw_programa_beneficio' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("10.58.5.16", "ANS"),
				    public_vw_programa_beneficio = Fonte{[Schema="public",Item="vw_programa_beneficio"]}[Data],
				    #"Personalização Adicionada" = Table.AddColumn(
				    public_vw_programa_beneficio,
				    "estado",
				    each
				        if [sg_uf] = "AC" then "Acre"
				        else if [sg_uf] = "AL" then "Alagoas"
				        else if [sg_uf] = "AP" then "Amapá"
				        else if [sg_uf] = "AM" then "Amazonas"
				        else if [sg_uf] = "BA" then "Bahia"
				        else if [sg_uf] = "CE" then "Ceará"
				        else if [sg_uf] = "DF" then "Distrito Federal"
				        else if [sg_uf] = "ES" then "Espírito Santo"
				        else if [sg_uf] = "GO" then "Goiás"
				        else if [sg_uf] = "MA" then "Maranhão"
				        else if [sg_uf] = "MT" then "Mato Grosso"
				        else if [sg_uf] = "MS" then "Mato Grosso do Sul"
				        else if [sg_uf] = "MG" then "Minas Gerais"
				        else if [sg_uf] = "PA" then "Pará"
				        else if [sg_uf] = "PB" then "Paraíba"
				        else if [sg_uf] = "PR" then "Paraná"
				        else if [sg_uf] = "PE" then "Pernambuco"
				        else if [sg_uf] = "PI" then "Piauí"
				        else if [sg_uf] = "RJ" then "Rio de Janeiro"
				        else if [sg_uf] = "RN" then "Rio Grande do Norte"
				        else if [sg_uf] = "RS" then "Rio Grande do Sul"
				        else if [sg_uf] = "RO" then "Rondônia"
				        else if [sg_uf] = "RR" then "Roraima"
				        else if [sg_uf] = "SC" then "Santa Catarina"
				        else if [sg_uf] = "SP" then "São Paulo"
				        else if [sg_uf] = "SE" then "Sergipe"
				        else if [sg_uf] = "TO" then "Tocantins"
				        else null
				),
				    #"Valor Substituído" = Table.ReplaceValue(#"Personalização Adicionada","Concluído com Pendência","Pendência",Replacer.ReplaceText,{"nm_status_tarefa"}),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Valor Substituído", "estado_normalizado", each List.Accumulate(
				    {
				        {"á","a"},{"à","a"},{"ã","a"},{"â","a"},{"ä","a"},
				        {"é","e"},{"è","e"},{"ê","e"},{"ë","e"},
				        {"í","i"},{"ì","i"},{"î","i"},{"ï","i"},
				        {"ó","o"},{"ò","o"},{"õ","o"},{"ô","o"},{"ö","o"},
				        {"ú","u"},{"ù","u"},{"û","u"},{"ü","u"},
				        {"ç","c"},
				        {"Á","A"},{"À","A"},{"Ã","A"},{"Â","A"},{"Ä","A"},
				        {"É","E"},{"È","E"},{"Ê","E"},{"Ë","E"},
				        {"Í","I"},{"Ì","I"},{"Î","I"},{"Ï","I"},
				        {"Ó","O"},{"Ò","O"},{"Õ","O"},{"Ô","O"},{"Ö","O"},
				        {"Ú","U"},{"Ù","U"},{"Û","U"},{"Ü","U"},
				        {"Ç","C"}
				    },
				    [estado],
				    (resultado, atual) => Text.Replace(resultado, atual{0}, atual{1})
				))
				in
				    #"Personalização Adicionada1"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

